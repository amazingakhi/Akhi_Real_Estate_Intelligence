# ============================================================================
#  Akhi Real Estate Intelligence (AREI™) — Production Environment Config
#  Copy this file to `.env` and fill in all values before deploying.
#  NEVER commit `.env` to git — it is already in .gitignore.
# ============================================================================

# ── App Identity ─────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME="Akhi Real Estate Intelligence"
APP_TAGLINE="Institutional-Grade Property Data & Automated Valuation Suite"
APP_VERSION=2.1.0

# ── Contact & Branding ───────────────────────────────────────────────────────
CONTACT_NUMBER=6387594514
CONTACT_EMAIL=iamakv01@gmail.com
INSTAGRAM_URL=https://instagram.com/youknow_akhi
WHATSAPP_NUMBER=916387594514
OFFICIAL_WEBSITE=https://akhiproperties.com

# ── Admin Credentials ────────────────────────────────────────────────────────
# The admin account is auto-created on first startup if AKHI_ADMIN_PASSWORD is set.
AKHI_ADMIN_EMAIL=iamakv01@gmail.com
AKHI_ADMIN_PASSWORD=ChangeMe@2024!StrongPassword

# ── JWT Session Security ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256

# ── Redis (optional — only needed for distributed/multi-worker deployments) ──
# Leave blank or comment out to use in-memory rate limiting (default for single-worker).
REDIS_URL=redis://localhost:6379/0

# ── Payment Gateway — Razorpay ───────────────────────────────────────────────
# Create account: https://dashboard.razorpay.com
# Use rzp_test_* keys for staging, rzp_live_* for production.
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_SECRET

# ── Email / SMTP (lead alerts + buyer confirmation) ──────────────────────────
# Gmail: enable 2FA → Google Account → Security → App Passwords → generate one.
# Zoho / Outlook also supported — just change SMTP_HOST and SMTP_PORT.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=Akhi Real Estate Intelligence
# Admin email that receives new lead notifications:
NOTIFY_EMAIL=iamakv01@gmail.com

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use the default SQLite database (data/akhi_properties.db).
# For PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave blank to disable.
GA_MEASUREMENT_ID=

# ── Security Flags ───────────────────────────────────────────────────────────
# Set to "true" to enforce HTTPS-only cookies (required on production HTTPS hosts).
SECURE_COOKIES=true
